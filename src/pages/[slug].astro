---
import Layout from '../layouts/Layout.astro';
import { posts, description, formatDate, readingTime } from '../lib/posts';
import { renderContent, renderComment } from '../lib/render';
export function getStaticPaths() { return posts.map(post => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props;
const { html, headings } = await renderContent(post.originalContent, post.id);
const index = posts.findIndex(p => p.slug === post.slug);
const older = posts[index + 1];
const newer = posts[index - 1];
const schema = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title,
  datePublished: post.publishedAt, dateModified: post.updatedAt, author: { '@type':'Person', name:post.author },
  description:description(post), mainEntityOfPage:new URL(`/${post.slug}/`, Astro.site).href };
---
<Layout title={post.title} description={description(post)} article={post}>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <div class="post-shell wrap">
    <header class="article-header">
      <a class="back-link" href="/#articles">← All writing</a>
      <div class="post-categories">{post.categories.map(c => <a href={`/category/${c.slug}/`}>{c.name}</a>)}</div>
      <h1>{post.title}</h1>
      <p class="post-meta"><time datetime={post.publishedAt}>{formatDate(post.localDate)}</time><span>/</span><span>{post.author}</span><span>/</span><span>{readingTime(post)} min read</span></p>
    </header>
    <div class="article-grid">
      <div class="article-main">
        <article class="prose" set:html={html} />
        <div class="article-tags" aria-label="Article tags">{post.tags.map(t => <a href={`/tag/${t.slug}/`}>#{t.name}</a>)}</div>
        <nav class="adjacent-posts" aria-label="More writing">
          {older ? <a href={`/${older.slug}/`}><span class="eyebrow">← Earlier note</span><strong>{older.title}</strong></a> : <span />}
          {newer && <a href={`/${newer.slug}/`}><span class="eyebrow">Later note →</span><strong>{newer.title}</strong></a>}
        </nav>
        <section class="comments" id="comments" aria-labelledby="comments-title">
          <h2 id="comments-title">Conversation<span class="count">{post.comments.length}</span></h2>
          <p class="comments-note">Comments from the original blog. Preserved as a read-only archive.</p>
          {post.comments.length === 0 && <p class="comments-note">No comments were posted.</p>}
          <ol class="comment-list">{post.comments.map(c => <li id={`comment-${c.id}`}>
            <div class="comment-header"><strong>{c.author}</strong><a href={`#comment-${c.id}`}><time datetime={c.publishedAt}>{formatDate(c.localDate)}</time></a></div>
            {c.parent !== 0 && post.comments.some(parent => parent.id === c.parent) && <a class="comment-parent" href={`#comment-${c.parent}`}>↳ Reply to {post.comments.find(parent => parent.id === c.parent)?.author}</a>}
            <div class="comment-content" set:html={renderComment(c.content)} />
          </li>)}</ol>
          <span id="respond"></span>
        </section>
      </div>
      {headings.length > 0 && <aside class="article-sidebar"><nav aria-label="On this page"><p class="eyebrow">On this page</p>{headings.map(h => <a href={`#${h.id}`}>{h.text}</a>)}<a href="#comments">Conversation ({post.comments.length})</a></nav></aside>}
    </div>
  </div>
</Layout>
