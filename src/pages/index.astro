---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import { posts, categories } from '../lib/posts';
const legacyIds = Object.fromEntries(posts.map(p => [p.id, `/${p.slug}/`]));
---
<Layout>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> X-N2O's Blog · Est. 2009</p>
      <h1>Notes close<br />to the <em>metal.</em></h1>
      <p class="hero-description">Programming, cryptography, reverse engineering.<br />A few things learned by taking things apart.</p>
      <a class="text-link" href="#articles">Explore the writing <span aria-hidden="true">↓</span></a>
    </div>
    <figure class="hero-art">
      <div class="terminal-chrome" aria-hidden="true"><span></span><span></span><span></span><small>x-n2o.net</small></div>
      <img src="/images/original-header.jpg" width="760" height="200" alt="Original blog banner: It's now safe to turn off your computer. X-N2O's blog." fetchpriority="high" />
      <figcaption><span>From the original blog</span><span aria-hidden="true">[ 2009 — 2012 ]</span></figcaption>
    </figure>
  </section>
  <section class="writing wrap" id="articles" aria-labelledby="writing-title">
    <div class="section-heading"><div><p class="eyebrow">The notebook</p><h2 id="writing-title">Writing<span class="count">{posts.length}</span></h2></div>
      <div class="search"><label for="post-search" class="sr-only">Search articles</label><span aria-hidden="true">⌕</span><input type="search" id="post-search" placeholder="Find a note…" autocomplete="off" /></div>
    </div>
    <div class="writing-grid">
      <div><PostList posts={posts} searchable /><p id="search-empty" class="empty-state" hidden>No notes match your search.</p><p id="search-status" class="sr-only" role="status" aria-live="polite"></p></div>
      <aside class="topic-sidebar" aria-label="Browse by topic"><p class="eyebrow">Browse by topic</p>
        {categories.map(c => <a href={`/category/${c.slug}/`}><span>{c.name}</span><span>{posts.filter(p => p.categories.some(t => t.slug === c.slug)).length}</span></a>)}
        <div class="archive-note"><span class="archive-symbol" aria-hidden="true">{ '{ }' }</span><p>Old notes. Original dates.<br />Still here to be read.</p><a class="text-link" href="/archive/">View the archive ↗</a></div>
      </aside>
    </div>
  </section>
  <script define:vars={{ legacyIds }}>
    const query = new URLSearchParams(location.search);
    const postUrl = legacyIds[query.get('p')];
    if (postUrl) location.replace(postUrl + location.hash);
    if (query.has('feed')) location.replace('/rss.xml');
  </script>
  <script>
    const input = document.querySelector<HTMLInputElement>('#post-search');
    const rows = [...document.querySelectorAll<HTMLElement>('.post-row')];
    const empty = document.querySelector<HTMLElement>('#search-empty');
    const status = document.querySelector<HTMLElement>('#search-status');
    function search() {
      const terms = (input?.value.toLowerCase().trim() || '').split(/\s+/).filter(Boolean);
      let count = 0;
      rows.forEach(row => { row.hidden = !terms.every(term => row.dataset.search?.includes(term)); if (!row.hidden) count++; });
      if (empty) empty.hidden = count !== 0;
      if (status) status.textContent = `${count} ${count === 1 ? 'article' : 'articles'} found`;
    }
    input?.addEventListener('input', search);
    const legacySearch = new URLSearchParams(location.search).get('s');
    if (legacySearch && input) { input.value = legacySearch; search(); }
  </script>
</Layout>
