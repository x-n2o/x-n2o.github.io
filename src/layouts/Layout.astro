---
import '../styles/global.css';
interface Props { title?: string; description?: string; article?: { publishedAt: string; updatedAt: string }; }
const { title, description = 'Notes on programming, cryptography and reverse engineering by X-N2O.', article } = Astro.props;
const pageTitle = title ? `${title} · X-N2O` : 'X-N2O · Notes close to the metal';
const isNotFound = Astro.url.pathname === '/404/' || Astro.url.pathname === '/404.html';
const canonical = new URL(isNotFound ? '/404.html' : Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {isNotFound && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f8f7f4" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title="X-N2O's Blog" href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:image" content={new URL('/images/original-header.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary" />
    {article && <><meta property="article:published_time" content={article.publishedAt} /><meta property="article:modified_time" content={article.updatedAt} /></>}
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('xn2o-theme');
        document.documentElement.dataset.theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="X-N2O home"><span class="brand-mark">x</span> X-N2O<span class="wordmark-dot">.</span></a>
      <nav aria-label="Main navigation">
        <a href="/#articles">Writing</a>
        <a href="/archive/">Archive</a>
        <a href="/rss.xml" class="rss-link">RSS <span aria-hidden="true">↗</span></a>
        <button id="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">◐</button>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="footer-brand" href="/">X-N2O</a><span>It's now safe to turn off your computer.</span></div>
      <div><a href="/archive/">2009–2012</a><a href="https://github.com/x-n2o/x-n2o.github.io">Source ↗</a><a href="/rss.xml">RSS ↗</a></div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const updateLabel = () => { if (toggle) toggle.setAttribute('aria-label', `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} theme`); };
      updateLabel();
      toggle?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('xn2o-theme', theme); } catch {}
        updateLabel();
      });
      document.querySelectorAll<HTMLButtonElement>('.copy-code').forEach((button) => {
        button.addEventListener('click', async () => {
          const code = button.closest('.code-block')?.querySelector('code')?.textContent;
          if (!code) return;
          try { await navigator.clipboard.writeText(code); button.textContent = 'Copied'; }
          catch { button.textContent = 'Select code to copy'; }
          setTimeout(() => { button.textContent = 'Copy'; }, 2200);
        });
      });
    </script>
  </body>
</html>
